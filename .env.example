# Serper News API Key (https://serper.dev/)
SERPER_API_KEY=your_serper_api_key_here

# Google AI Studio Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명
GEMINI_MODEL=gemini-3.8-flash

# Flask 디버그 모드 (true / false)
FLASK_DEBUG=true

# Dify 챗봇 백엔드 서비스 API 설정 (무료 2슬롯 분리)
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_ANALYSIS_API_KEY=your_dify_analysis_chatbot_api_key
DIFY_TECH_API_KEY=your_dify_tech_chatbot_api_key

# 금융감독원 OpenDART API Key (https://opendart.fss.or.kr/)
DART_API_KEY=your_dart_api_key_here
